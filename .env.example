# Copy to .env and fill in. .env is git-ignored.

# ---- Telegram (recommended) ----
# Token from @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=123456789:AAH...
# Filled in automatically by: python claude_comm.py setup
# TELEGRAM_CHAT_ID=

# ---- Email (alternative; used when no TELEGRAM_BOT_TOKEN is set) ----
# CLAUDE_MAIL_ADDRESS=claude.bot@example.com
# CLAUDE_MAIL_PASSWORD=app password
# CLAUDE_MAIL_OWNER=you@example.com
# CLAUDE_MAIL_SMTP_HOST=smtp.gmail.com
# CLAUDE_MAIL_SMTP_PORT=465
# CLAUDE_MAIL_IMAP_HOST=imap.gmail.com
# CLAUDE_MAIL_IMAP_PORT=993
# CLAUDE_MAIL_POLL_INTERVAL=30
# CLAUDE_MAIL_REQUIRE_AUTH=true

# ---- General ----
# telegram or email (default: telegram if TELEGRAM_BOT_TOKEN is set)
# CLAUDE_COMM_BACKEND=telegram
# Seconds ask/wait block before giving up
# CLAUDE_COMM_DEFAULT_TIMEOUT=7200
